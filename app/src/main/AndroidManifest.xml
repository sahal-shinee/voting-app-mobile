<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SuaraKitaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SuaraKita">

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.ChangePasswordActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.StudentDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.VotingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.ConfirmationActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.ResultsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminCategoryFormActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminCandidateFormActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminResultsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminCategoryTrashActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminActivityLogActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminNonVotersActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminCategoryDetailActivity"
            android:exported="false" />

    </application>

</manifest>
